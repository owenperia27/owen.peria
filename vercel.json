{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/BVAS",
      "destination": "/festivals/bvas",
      "statusCode": 301
    },
    {
      "source": "/BVAS.html",
      "destination": "/festivals/bvas",
      "statusCode": 301
    },
    {
      "source": "/bvas",
      "destination": "/festivals/bvas",
      "statusCode": 301
    },
    {
      "source": "/bvas.html",
      "destination": "/festivals/bvas",
      "statusCode": 301
    },
    {
      "source": "/BVAS/:path*",
      "destination": "/festivals/bvas",
      "statusCode": 301
    },
    {
      "source": "/ROSE",
      "destination": "/festivals/rose",
      "statusCode": 301
    },
    {
      "source": "/ROSE.html",
      "destination": "/festivals/rose",
      "statusCode": 301
    },
    {
      "source": "/rose",
      "destination": "/festivals/rose",
      "statusCode": 301
    },
    {
      "source": "/rose.html",
      "destination": "/festivals/rose",
      "statusCode": 301
    },
    {
      "source": "/ROSE/:path*",
      "destination": "/festivals/rose",
      "statusCode": 301
    },
    {
      "source": "/FRANCOFOLIES",
      "destination": "/festivals/francofolies",
      "statusCode": 301
    },
    {
      "source": "/FRANCOFOLIES.html",
      "destination": "/festivals/francofolies",
      "statusCode": 301
    },
    {
      "source": "/francofolies",
      "destination": "/festivals/francofolies",
      "statusCode": 301
    },
    {
      "source": "/francofolies.html",
      "destination": "/festivals/francofolies",
      "statusCode": 301
    },
    {
      "source": "/FRANCOFOLIES/:path*",
      "destination": "/festivals/francofolies",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/artists/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/studio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/personal/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/bvas-rio-loco/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/rose-festival/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/francofolies/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
